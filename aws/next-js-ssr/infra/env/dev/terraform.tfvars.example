# 共通
region      = "ap-northeast-1"
name_prefix = "next-js-ssr-dev"

tags = {
  Project   = "next-js-ssr"
  Env       = "dev"
  Terraform = "true"
}

# VPC
vpc_cidr = "10.0.0.0/16"

# subnet
azs = [
  "ap-northeast-1a",
  "ap-northeast-1c"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

# アプリ用サブネット（ECS・踏み台を配置）
app_subnet_cidrs = [
  "10.0.101.0/24",
  "10.0.102.0/24"
]

# DB用サブネット（NATへのルートなし。Auroraを配置）
db_subnet_cidrs = [
  "10.0.201.0/24",
  "10.0.202.0/24"
]

# aurora
db_name     = "app"
db_username = "postgres"
db_password = "CHANGE_ME" # 実際の値はコミットしないこと

# ecs
container_port = 3000

# ECRリポジトリ名は {name_prefix}-app（terraform output ecr_repository_url で確認できる）
container_image = "{ACCOUNT_ID}.dkr.ecr.ap-northeast-1.amazonaws.com/next-js-ssr-dev-app:{TAG}"