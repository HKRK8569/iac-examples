# ローカル開発：ブラウザはHTTP、compose.yamlのDBはTLSなし
DB_WRITER_ENDPOINT=localhost
DB_READER_ENDPOINT=localhost
DB_PORT=5433
DB_NAME=app
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SSL_MODE=disable

# Aurora接続時はverify-fullに変更し、AWSのCA証明書を指定する。
# DB_SSL_MODE=verify-full
# DB_SSL_CA_PATH=./certs/global-bundle.pem
# SSMトンネル時のみ指定（TCP接続先は127.0.0.1:15432）。
# DB_SSL_SERVERNAME=your-cluster.cluster-xxxxxxxx.ap-northeast-1.rds.amazonaws.com

IMAGES_BUCKET_NAME=
# 省略時はページと同じドメインの /images/* を使用。ローカルでCloudFrontの画像を表示する場合に指定。
NEXT_PUBLIC_CDN_DOMAIN=
